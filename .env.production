# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Vagus Asistent — Production Environment                           ║
# ║  Copy to .env and fill in real values before deploying              ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Application ──────────────────────────────────────────────────────────
VAGUS_ENV=production
VAGUS_DEBUG=false
VAGUS_LOG_LEVEL=INFO
VAGUS_JWT_SECRET=CHANGE-ME-generate-a-64-char-random-string
VAGUS_ADMIN_USER=admin
VAGUS_ADMIN_PASSWORD=CHANGE-ME-strong-password

# ── API Server ───────────────────────────────────────────────────────────
API_PORT=8000
API_WORKERS=4

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=vagus
POSTGRES_PASSWORD=CHANGE-ME-db-password
POSTGRES_DB=vagus
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vagus:CHANGE-ME-db-password@postgres:5432/vagus

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── LLM Providers ───────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ── Nginx / SSL ──────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
SERVER_NAME=vagus.example.com

# ── Telegram Bot ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Streamlit Dashboard ─────────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── Monitoring ───────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE-ME-grafana-password

# ── Misc ─────────────────────────────────────────────────────────────────
OPENBLAS_NUM_THREADS=1
