# =============================================================================
# Vagus Asistent — шаблон переменных окружения
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/macOS)
#
# ВАЖНО: .env содержит секреты — никогда не коммитьте его в git!
# =============================================================================

# ─── Технические настройки ───────────────────────────────────────────────────
# Устраняет ошибку памяти при инициализации числовых библиотек
OPENBLAS_NUM_THREADS=1

# ─── LLM Provider API Keys ───────────────────────────────────────────────────
# Обязательно: хотя бы один провайдер должен быть настроен
#
# OpenAI  →  https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic  →  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek  →  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (агрегатор, опционально)  →  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Telegram Alerting (опционально) ─────────────────────────────────────────
# Шаг 1: создайте бота через @BotFather → /newbot  → скопируйте токен
# Шаг 2: узнайте свой chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VAGUS_API_URL=http://127.0.0.1:8000
VAGUS_BOT_USERNAME=
VAGUS_BOT_PASSWORD=

# ─── Безопасность ────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: сгенерируйте командой: python -c "import secrets; print(secrets.token_urlsafe(64))"
VAGUS_SECRET_KEY=
# Администратор (генерировать хеш: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())")
VAGUS_ADMIN_USERNAME=
VAGUS_ADMIN_PASSWORD_HASH=

# Пользователь (опционально)
VAGUS_USER_USERNAME=
VAGUS_USER_PASSWORD_HASH=

# CORS origins (через запятую)
VAGUS_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Master key для шифрования хранилища ключей (если не задан — генерируется автоматически)
# Задайте вручную для воспроизводимого окружения (CI/staging):
#   python -c "import secrets; print(secrets.token_hex(32))"
# VAGUS_KEYS_MASTER_KEY=

# ─── Настройки серверов ──────────────────────────────────────────────────────
VAGUS_API_HOST=127.0.0.1
VAGUS_API_PORT=8000
VAGUS_DASHBOARD_PORT=8501
VAGUS_MARKETPLACE_PORT=8010

# ─── Среда выполнения ────────────────────────────────────────────────────────
# Допустимые значения: development | staging | production
ENVIRONMENT=development
