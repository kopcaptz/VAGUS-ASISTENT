# Vagus Asistent - API ключи провайдеров
# Скопируйте в .env и заполните значения

# OpenBLAS: устраняет ошибку памяти при инициализации провайдеров (Windows)
OPENBLAS_NUM_THREADS=1

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter (опционально)
OPENROUTER_API_KEY=

# Google (опционально)
GOOGLE_API_KEY=

# Layer 3: JWT Secret Key
VAGUS_SECRET_KEY=your-secret-key-change-in-production

# Layer 3: Telegram Bot
TELEGRAM_BOT_TOKEN=
