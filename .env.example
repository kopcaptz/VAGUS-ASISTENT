# Vagus Asistent - API ключи провайдеров
# Скопируйте в .env и заполните значения

# OpenBLAS: устраняет ошибку памяти при инициализации провайдеров (Windows)
OPENBLAS_NUM_THREADS=1

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter (опционально)
OPENROUTER_API_KEY=

# Google (опционально)
GOOGLE_API_KEY=

# Telegram Bot (Layer 3)
TELEGRAM_BOT_TOKEN=
VAGUS_API_URL=http://localhost:8000
VAGUS_API_KEY=
# Ограничить доступ по user_id (через запятую, пустое = все)
TELEGRAM_ALLOWED_USERS=
